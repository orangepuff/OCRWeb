<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Endpoint library: needs the ASP.NET surface (IFormFile, results, etc.). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="MediatR" />
  </ItemGroup>

  <!-- Use local source when available (local debug); fall back to NuGet in Docker / CI. -->
  <Choose>
    <When Condition="Exists('D:\orangepuffportal\src\OrangepuffPortal.Host\OrangepuffPortal.Host.csproj')">
      <ItemGroup>
        <ProjectReference Include="D:\orangepuffportal\src\OrangepuffPortal.Config.Contract\OrangepuffPortal.Config.Contract.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OrangepuffPortal.Config.Contract" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <ProjectReference Include="..\OCRWeb.Document\OCRWeb.Document.csproj" />
    <ProjectReference Include="..\OCRWeb.Document.Contract\OCRWeb.Document.Contract.csproj" />
  </ItemGroup>

</Project>
