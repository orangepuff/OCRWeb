<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MediatR" />
  </ItemGroup>

  <!-- Use local source when available (local debug); fall back to NuGet in Docker / CI. -->
  <Choose>
    <When Condition="Exists('D:\orangepuffportal\src\OrangepuffPortal.Host\OrangepuffPortal.Host.csproj')">
      <ItemGroup>
        <ProjectReference Include="D:\orangepuffportal\src\OrangepuffPortal.Shared\OrangepuffPortal.Shared.csproj" />
        <ProjectReference Include="D:\orangepuffportal\src\OrangepuffPortal.Config.Contract\OrangepuffPortal.Config.Contract.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OrangepuffPortal.Shared" />
        <PackageReference Include="OrangepuffPortal.Config.Contract" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <ProjectReference Include="..\OCRWeb.Shared\OCRWeb.Shared.csproj" />
    <ProjectReference Include="..\OCRWeb.Document.Contract\OCRWeb.Document.Contract.csproj" />
    <ProjectReference Include="..\OCRWeb.Pdf.Contract\OCRWeb.Pdf.Contract.csproj" />
    <ProjectReference Include="..\OCRWeb.ProjectManagement.Contract\OCRWeb.ProjectManagement.Contract.csproj" />
  </ItemGroup>

</Project>
